# Fastlane configuration template.
#
# Copy to fastlane/.env (gitignored) and fill in YOUR values.
# These values are NOT secrets — they're public identifiers from your Apple
# Developer / Google Play account. Real secrets (.p8, keystore passwords,
# service account JSON) live in macOS Keychain — see fastlane/README.md.

# Apple Developer team ID (10 alphanumeric chars).
# Find at: https://developer.apple.com → Account → Membership Details → Team ID
APPLE_TEAM_ID=YOURAPPLETEAMID

# App bundle identifier. Must match the provisioning profile and the
# CFBundleIdentifier in your Xcode project.
APP_IDENTIFIER=com.example.app

# iOS App Store provisioning profile NAME (not UUID), as it appears in
# Apple Developer Portal → Profiles or ~/Library/MobileDevice/Provisioning Profiles/.
IOS_PROFILE_NAME=YourApp AppStore
