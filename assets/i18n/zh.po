#. Section title of the author page listing the books of this author already in the library, {count} is how many
msgid "author_page_in_library"
msgstr "您的藏书（{count}）"

#. Author page, shown when no book of this author is in the library
msgid "author_page_no_local_books"
msgstr "您的藏书中没有这位作者的书。"

#. Section title of the author page listing works of this author the library does not hold
msgid "author_page_to_discover"
msgstr "待发现"

#. Screen-reader label of a tappable author name opening the author page, {author} is the author name
msgid "author_page_open_semantic"
msgstr "{author} 的作品"

#. Segment of the library top slot showing recent activity, {count} is how many books it lists (ADR-062)
msgid "books_slot_segment_activity"
msgstr "近期动态 · {count}"

#. Segment of the library top slot showing reading suggestions, {count} is how many are available (ADR-062)
msgid "books_slot_segment_discover"
msgstr "待发现 · {count}"

#. Tooltip of the library app-bar action opening the reading suggestions (ADR-062)
msgid "tooltip_open_recommendations"
msgstr "阅读推荐"

#. Suggestions page, line naming how many read books the taste profile rests on, {count} is how many
msgid "recommendations_basis_books"
msgstr "基于你读过的 {count} 本书"

#. Suggestions page, label of the authors the taste profile drew out
msgid "recommendations_basis_authors"
msgstr "你反复阅读的作者"

#. Suggestions page, label of the subjects the taste profile drew out
msgid "recommendations_basis_subjects"
msgstr "你阅读的主题"

#. Suggestions page, second line of the empty state saying what brings suggestions back
msgid "recommendations_empty_hint"
msgstr "添加或读完几本书，推荐就会回来。"

#. Screen-reader label of the suggestions page while the engine is still answering
msgid "recommendations_loading"
msgstr "正在加载推荐"

#. Section header of the ownership axis in the /books filter menu (ADR-063)
msgid "ownership_filter"
msgstr "拥有情况"

#. Ownership filter: books physically present (owned or on loan)
msgid "ownership_library"
msgstr "我的书库"

#. Ownership filter: books neither owned nor on loan (wishlist, read elsewhere)
msgid "ownership_not_owned"
msgstr "未拥有"

#. Ownership filter: every book the app knows, owned or not
msgid "ownership_all"
msgstr "全部"

#. Heading of the block offered on a book page right after it is marked as read, introducing what to read next (ADR-062 R5)
msgid "reading_completion_continue_with"
msgstr "接下来读"

#. Display name of the typed favorites collection (ADR-064); the stored name is a technical sentinel, never shown
msgid "favorites_collection_name"
msgstr "收藏"

#. Semantic fragment appended to a book card label when the book is a favorite
msgid "favorite_marker_label"
msgstr "收藏"

#. Tooltip/label of the favorite toggle on the book page, when the book is not yet a favorite
msgid "favorite_toggle_add"
msgstr "添加到收藏"

#. Tooltip/label of the favorite toggle on the book page, when the book is already a favorite
msgid "favorite_toggle_remove"
msgstr "从收藏中移除"

#. Snackbar after marking a book as favorite
msgid "favorite_added"
msgstr "已添加到收藏"

#. Snackbar after unmarking a favorite
msgid "favorite_removed"
msgstr "已从收藏中移除"

#. Snackbar when the favorite toggle fails
msgid "favorite_toggle_error"
msgstr "无法更新收藏"

#. Title of the one-shot dialog offering to adopt a manual favorites-like collection
msgid "favorites_adopt_title"
msgstr "使用现有合集？"

#. Body of the adoption dialog. {name} = collection name, {count} = member count
msgid "favorites_adopt_body"
msgstr "您的合集「{name}」（{count} 本书）可以成为您的收藏合集。其中的书将标记为收藏，并充实您的阅读建议。"

#. Adoption dialog: accept button
msgid "favorites_adopt_accept"
msgstr "使用它"

#. Adoption dialog: decline button (remembered, never asked again)
msgid "favorites_adopt_decline"
msgstr "否，新建一个"

#. Dashboard Discover tile introducing the favorites marker
msgid "discover_favorites_marker"
msgstr "标记您喜爱的书"

#. Help screen: favorites topic title
msgid "help_topic_favorites"
msgstr "收藏"

#. Help screen: favorites topic description
msgid "help_desc_favorites"
msgstr "在书籍页面用星形书签将其标记为收藏。收藏会汇集到收藏合集中，并增强您的阅读建议。一切都保存在您的设备上。"

#. Curated list card: link unfolding the full book list, {count} is the total
msgid "curated_see_all_books"
msgstr "查看全部{count}本书"

#. Curated list card: link folding the book list back to the 3-book preview
msgid "curated_see_less"
msgstr "收起"

#. Collections screen: header of the related curated selections block
msgid "curated_affinity_section_title"
msgstr "与你的藏书相关的书单"

#. Curated list card: why it is suggested, {owned} books already in the library
msgid "curated_affinity_reason"
msgstr "有 {owned} 本共同的书"

#. Curated list card: same, when {liked} of the shared books were liked
msgid "curated_affinity_reason_liked"
msgstr "有 {owned} 本共同的书，其中 {liked} 本是你喜欢的"

#. Source marker on a suggested curated selection
msgid "suggestion_badge_editorial"
msgstr "书单"

#. Pre-import dialog: file the imported books under their matching genre shelves
msgid "curated_import_shelve_option"
msgstr "按类型整理导入的书"

#. Pre-import dialog: the shelves that would be used, {labels} is a list
msgid "curated_import_shelve_option_detail"
msgstr "书架：{labels}"

#. Shelf empty only because the ownership view hides its books
msgid "shelf_hidden_by_ownership"
msgstr "此书架上的书都不在您的藏书中"

#. Explains the empty shelf, {count} is how many books the switch would reveal
msgid "shelf_hidden_by_ownership_desc"
msgstr "此书架上有 {count} 本书不在您手中：心愿单，或已外借的书。默认视图只显示您拥有的书。"

#. Button switching the library list to the 'all' ownership scope
msgid "show_all_ownership"
msgstr "仍然显示"

#. Share panel: title
msgid "collection_share_title"
msgstr "分享此书单"

#. Share panel: what the recipient gets, and that their library is untouched until they confirm
msgid "collection_share_explainer"
msgstr "对方会收到一个 BiblioGenius 书单文件。在他确认之前，什么都不会进入他的藏书。"

#. Share panel: how many books the list holds, {count}
msgid "collection_share_count"
msgstr "{count} 本书"

#. Share panel: the list's declared reading languages, {languages}
msgid "collection_share_languages"
msgstr "已声明语言：{languages}"

#. Share panel: copy the list as text, which the import can paste
msgid "collection_share_copy"
msgstr "复制"

#. Share panel: send the list as a file
msgid "collection_share_send"
msgstr "发送文件"

#. Confirmation after copying the list to the clipboard
msgid "collection_share_copied"
msgstr "书单已复制"

#. Text accompanying a shared list file, {name} and {count}
msgid "collection_share_message"
msgstr "阅读书单《{name}》（{count} 本书）"

#. Import screen: heading of the accepted-formats card
msgid "import_supported_formats"
msgstr "支持的格式"

#. Import screen: the accepted formats, naming the Share action that produces them
msgid "import_supported_formats_detail"
msgstr "• 由「分享」发送的 .bibliogenius.yml 文件\n• .yaml 或 .yml 文件\n• 从剪贴板粘贴的书单"


#. --- Contact card and contact channels (ADR-067) ---

#. Hub contact card: email field label
msgid "hub_contact_email_label"
msgstr "电子邮件"

#. Hub contact card: phone field label
msgid "hub_contact_phone_label"
msgstr "电话"

#. Hub contact card: why the international format is required
msgid "hub_contact_phone_helper"
msgstr "请使用国际格式（+86...），以便使用 WhatsApp"

#. Hub contact card: free note field label
msgid "hub_contact_note_label"
msgstr "补充说明（可选）"

#. Hub contact card: free note field hint
msgid "hub_contact_note_hint"
msgstr "地址、开放时间、方便的时段……"

#. Peer book sheet: button opening the contact channels
msgid "contact_cta"
msgstr "联系"

#. Contact channels sheet: title
msgid "contact_sheet_title"
msgstr "联系该图书馆"

#. Contact channels sheet: open the mail client
msgid "contact_action_email"
msgstr "发送电子邮件"

#. Contact channels sheet: open the SMS app
msgid "contact_action_sms"
msgstr "发送短信"

#. Contact channels sheet: open WhatsApp
msgid "contact_action_whatsapp"
msgstr "WhatsApp"

#. Contact channels sheet: copy the contact details
msgid "contact_action_copy"
msgstr "复制联系方式"

#. Confirmation after copying the contact details
msgid "contact_copied"
msgstr "已复制联系方式"

#. No app could open the contact link
msgid "contact_launch_failed"
msgstr "没有应用可以打开此链接"

#. Prefilled message subject about a book, {title}
msgid "contact_message_subject"
msgstr "借阅：{title}"

#. Prefilled message subject with no book context
msgid "contact_message_subject_plain"
msgstr "关于您的书房"

#. Prefilled message body about a book, {title}
msgid "contact_message_body"
msgstr "您好：\n\n我们在 BiblioGenius 上有联系，看到您的书房里有《{title}》。\n\n方便借给我吗？请告诉我什么时候取书方便，可以借多久。"

#. Prefilled message body about a book, {title} and {author}
msgid "contact_message_body_with_author"
msgstr "您好：\n\n我们在 BiblioGenius 上有联系，看到您的书房里有{author}的《{title}》。\n\n方便借给我吗？请告诉我什么时候取书方便，可以借多久。"

#. Prefilled message body with no book context
msgid "contact_message_body_plain"
msgstr "您好：\n\n我们在 BiblioGenius 上有联系，我可以看到您的书房。\n\n写信是想商量借书的事，请告诉我什么时候方便。"

#. Hub contact card: phone field placeholder, a local example number
msgid "hub_contact_phone_hint"
msgstr "+86 138 0013 8000"

#. Import preview: a list well past the usual size will be slow, {count} is how many books
msgid "import_large_list_warning"
msgstr "书单较长：{count} 本书。导入会逐本查询元数据，可能需要一些时间，离线时更久。"

#. Name given to an imported list when the library already holds one with that name, {title} and {contributor}
msgid "imported_collection_name_from"
msgstr "{contributor} 的{title}"

#. Refused before parsing: a shared list past the size bound
msgid "import_file_too_large"
msgstr "这个文件太大了，不像是一份书单。"


#. --- Contact card prompt (ADR-067 D9) ---

#. Contact prompt: title, on the banner and its sheet
msgid "contact_prompt_title"
msgstr "别人怎么联系您？"

#. Contact prompt: why it matters, in the sheet
msgid "contact_prompt_body"
msgstr "没有联系方式，就无法与您商定借书的地点和时间。只有您同意的图书馆才会收到，且经过加密。"

#. Contact prompt: what sharing cannot undo
msgid "contact_prompt_irreversible"
msgstr "一旦发出便无法收回。"

#. Contact prompt: one-line reason, on the banner
msgid "contact_prompt_banner_body"
msgstr "有图书馆关注了您，却联系不上您。"

#. Contact prompt: button opening the form
msgid "contact_prompt_action"
msgstr "添加我的联系方式"

#. Prefilled text message about a book, {title}
msgid "contact_message_short"
msgstr "您好，方便把《{title}》借给我吗？（来自 BiblioGenius）"

#. Prefilled text message with no book context
msgid "contact_message_short_plain"
msgstr "您好，我就您的书房与您联系。（来自 BiblioGenius）"

#. Extra line, only between paired libraries: a loan can go both ways
msgid "contact_message_reciprocity"
msgstr "也请告诉我，您想从我的书架上借些什么。"

#. Sign-off line of the prefilled message
msgid "contact_message_closing"
msgstr "先谢谢您，"
