#. Book details: header of the similar-books carousel (ADR-059)
msgid "recommendations_similar"
msgstr "Може също да харесате"

#. Dashboard: header of the personal suggestions section (ADR-059)
msgid "recommendations_personal"
msgstr "Предложения за вас"

#. Recommendation reason: shares an author, {value} is the author name
msgid "reason_same_author"
msgstr "Същият автор: {value}"

#. Recommendation reason, short form used on the chips: the author name is
#. already printed on the card, so repeating it inside the chip is noise
msgid "reason_same_author_short"
msgstr "Същият автор"

#. Recommendation reason: shares a shelf/genre label, {value} is the label
msgid "reason_shared_subject"
msgstr "Сходна тема: {value}"

#. Recommendation reason: same publisher, {value} is the publisher name
