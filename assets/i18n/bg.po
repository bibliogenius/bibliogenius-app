msgstr "Тази книга остава в библиотеката ви, отбелязана като непритежавана. Датите на четене, оценката и бележките се запазват."

msgid "return_keep_action"
msgstr "Запази я"

msgid "return_remove_action"
msgstr "Премахни я"

#. Series (reading-order timeline)
msgid "collection_series_toggle"
msgstr "Поредица"

msgid "collection_series_toggle_desc"
msgstr "Подредете томовете"

msgid "series_frieze_title"
msgstr "Поредица"

msgid "series_edit_volume"
msgstr "Номер на тома"

