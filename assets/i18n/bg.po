msgstr "Налична при"

#. Aggregated wishlist match for a curated list import
msgid "notif_wishlist_match_import"
msgstr "{count} книги от \"{list}\" са налични във вашата мрежа"

#. Accessibility/tooltip label for the wishlist availability badge
