#. Description for the peer cover display toggle.
msgid "peer_cover_display_enabled_desc"
msgstr "Когато е изключено, партньорските библиотеки използват изгледа с цветни гръбчета. Не се изтеглят и не се съхраняват корици."

#. Label for the peer cover cache size selector.
msgid "peer_cover_cache_cap"
msgstr "Макс. размер на кеша"

#. Description for the peer cover cache size selector.
msgid "peer_cover_cache_cap_desc"
msgstr "Дисково пространство за партньорски корици. По-старите корици се премахват, когато се запълни."

#. Title of the current-usage row below the cache size selector.
